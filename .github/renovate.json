{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        ":dependencyDashboard",
        ":rebaseStalePrs",
        ":renovatePrefix",
        ":semanticCommits",
        ":labels(dependencies)",
        "group:allNonMajor",
        "schedule:weekly",
        "helpers:pinGitHubActionDigests"
    ],
    "packageRules": [
        {
            "description": "Don't suggest Pre-Release Versions",
            "allowedVersions": "!/-.+\\.[0-9]+$/",
            "matchPackageNames": [
                "*"
            ]
        },
        {
            "description": "Disable Major Updates for the JDK",
            "matchDatasources": [
                "java-version"
            ],
            "matchPackageNames": [
                "java-jdk"
            ],
            "matchUpdateTypes": [
                "major"
            ],
            "enabled": false
        }
    ]
}
